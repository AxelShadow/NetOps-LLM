DB_PASSWORD=...
NETOPS_DATABASE_URL=sqlite:///./netops.db
# Для docker-compose (Postgres из сервиса db):
# NETOPS_DATABASE_URL=postgresql://netops:${DB_PASSWORD}@db:5432/netops
NETOPS_JWT_SECRET=...
NETOPS_AD_SERVER=ldaps://dc01.corp.local
NETOPS_AD_DOMAIN=corp.local
NETOPS_LLM_BASE_URL=http://localhost:1234/v1
NETOPS_BOOTSTRAP_ADMIN=admin@corp.local
NETOPS_DEV_MODE=true
NETOPS_ZABBIX_URL=http://zabbix.corp.local
NETOPS_ZABBIX_TOKEN=...
# Сервисный токен для /internal/* (Chainlit, nginx /_auth); пусто = внутренние маршруты выключены
NETOPS_INTERNAL_SERVICE_TOKEN=
# Секрет proxy-авторизации (auth-check для nginx, header-auth Chainlit);
# пусто = header-режим Chainlit выключен, работает только логин-форма
NETOPS_PROXY_AUTH_SECRET=
# Секрет сессий Chainlit (docker-compose: обязателен; генерация: chainlit create-secret)
CHAINLIT_AUTH_SECRET=
# Ключ шифрования чувствительных данных в БД (Fernet key). 
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETOPS_ENCRYPTION_KEY=
# RAG (Retrieval-Augmented Generation) настройки
RAG_ENABLED=false
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Планировщик задач (APScheduler) настройки
SCHEDULER_ENABLED=false
REPORT_RECIPIENTS=admin@corp.local
# Фаза 14: false — старый SPA основной (/ -> /legacy/), true — лендинг с выбором
NETOPS_USE_NEW_UI=false
# Порт nginx (docker-compose) наружу; на сервере, где 8080 занят, — 8081
WEB_PORT=8080
