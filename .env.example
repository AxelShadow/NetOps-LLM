DB_PASSWORD=...
NETOPS_DATABASE_URL=sqlite:///./netops.db
# Для docker-compose (Postgres из сервиса db):
# NETOPS_DATABASE_URL=postgresql://netops:${DB_PASSWORD}@db:5432/netops
NETOPS_JWT_SECRET=...
NETOPS_AD_SERVER=ldaps://dc01.corp.local
NETOPS_AD_DOMAIN=corp.local
NETOPS_LLM_BASE_URL=http://localhost:1234/v1
NETOPS_BOOTSTRAP_ADMIN=admin@corp.local
NETOPS_DEV_MODE=true
NETOPS_ZABBIX_URL=http://zabbix.corp.local
NETOPS_ZABBIX_TOKEN=...
# Сервисный токен для /internal/* (Chainlit, nginx /_auth); пусто = внутренние маршруты выключены
NETOPS_INTERNAL_SERVICE_TOKEN=
# Секрет proxy-авторизации (auth-check для nginx, header-auth Chainlit);
# пусто = header-режим Chainlit выключен, работает только логин-форма
NETOPS_PROXY_AUTH_SECRET=
# Секрет сессий Chainlit (docker-compose: обязателен; генерация: chainlit create-secret)
CHAINLIT_AUTH_SECRET=
# Ключ шифрования чувствительных данных в БД (Fernet-ключ, app/crypto.py:
# пароли устройств и SNMP community). Обязателен в проде: пусто и
# NETOPS_DEV_MODE=false -> приложение отказывается работать с этими полями.
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: смена ключа делает ранее записанные в БД значения нечитаемыми.
NETOPS_ENCRYPTION_KEY=
# Фаза 14: false — старый SPA основной (/ -> /legacy/), true — лендинг с выбором
NETOPS_USE_NEW_UI=false
# Порт nginx (docker-compose) наружу; на сервере, где 8080 занят, — 8081
WEB_PORT=8080

# --- RAG по runbook'ам (Этап 21) ---
# Каталог с .md/.txt runbook'ами; в docker-compose монтируется томом с хоста.
# Путь относительный считается от backend/ (cwd приложения).
NETOPS_RAG_ENABLED=false
NETOPS_RAG_DOCS_DIR=runbooks
NETOPS_RAG_QDRANT_URL=http://qdrant:6333
NETOPS_RAG_QDRANT_COLLECTION=netops_runbooks
# API-ключ Qdrant (сервис не проброшен наружу, ключ — hardening на будущее;
# пусто = без аутентификации внутри compose-сети)
NETOPS_RAG_QDRANT_API_KEY=
# Модель эмбеддингов на OpenAI-совместимом сервере (bge-m3 или
# Qwen3-Embedding-0.6B). Пусто — наследуются NETOPS_LLM_*.
# NETOPS_EMBEDDING_DIM должен совпадать с фактической размерностью модели.
NETOPS_EMBEDDING_BASE_URL=
NETOPS_EMBEDDING_MODEL=
# Ключ доступа к серверу эмбеддингов (пусто = NETOPS_LLM_API_KEY)
NETOPS_EMBEDDING_API_KEY=
NETOPS_EMBEDDING_DIM=1024
# Учётка SMTP Zimbra, получатели и шаблон письма задаются в админке
# (/admin/settings), а не здесь: это runtime-настройки app_settings.
# Здесь — только выключатель и таймзона планировщика.
NETOPS_SCHEDULER_ENABLED=false
NETOPS_SCHEDULER_TZ=Europe/Moscow
NETOPS_SCHEDULER_TIME_DEFAULT=08:00
