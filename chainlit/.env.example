# --- Chainlit-приложение (каталог chainlit/) ---
# Хост/порт для chainlit run (cli читает их сам)
CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8001
# Подпуть, под которым nginx проксирует приложение (/chat).
# В docker-compose ставится автоматически; при локальном запуске оставьте пустым.
CHAINLIT_ROOT_PATH=
# Секрет для подписи собственных cookie Chainlit: сгенерируйте `chainlit create-secret`
CHAINLIT_AUTH_SECRET=

# --- Подключение к FastAPI ---
# База FastAPI (пути /internal/chat/stream, /api/auth/* добавляются сами)
FASTAPI_INTERNAL_URL=http://localhost:8000
# Сервисный токен /internal/*; совпадает с NETOPS_INTERNAL_SERVICE_TOKEN бэкенда.
# Живёт только на сервере Chainlit (server-to-server), в браузер не попадает.
NETOPS_INTERNAL_SERVICE_TOKEN=

# --- Авторизация (Фаза 7) ---
# Секрет proxy-авторизации: nginx передаёт его в X-Proxy-Auth-Secret, Chainlit
# сверяет constant-time. Пусто = header-режим выключен (работает логин-форма).
NETOPS_PROXY_AUTH_SECRET=

# dev | production
ENVIRONMENT=development
