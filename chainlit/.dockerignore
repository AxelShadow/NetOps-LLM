# Контекст сборки chainlit (образ netops-llm-chainlit), корень = ./chainlit.
# Синтаксис .dockerignore (не .gitignore): пути от корня контекста,
# `**` поддерживается, порядок правил значим, `!` — исключение из исключения.
# Рантайм копируется явными COPY в Dockerfile: app.py, client.py, adapters.py,
# config.py, auth.py, chainlit.md, .chainlit/ (config.toml + translations).

# --- виртуальные окружения и кэши Python ---
.venv
venv
**/.venv
__pycache__
**/__pycache__
*.py[cod]
*.pyc
*.pyo
*.pyd
**/*.py[cod]
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
**/.pytest_cache
.mypy_cache
.ruff_cache

# --- БД и рантайм-артефакты ---
*.db
**/*.db
*.sqlite
*.sqlite3
**/*.sqlite*
*.log
logs
.files/
**/.files/

# --- секреты: не попадают ни в контекст, ни в слой образа ---
.env
.env.*
*.key
**/*.key
*.pem
**/*.pem
*.crt
*.p12
.secrets

# --- тесты, dev-сценарии и документация ---
# ВНИМАНИЕ: `*.md` здесь использовать нельзя — заодно выкинет chainlit.md,
# который нужен рантайму (приветствие Chainlit) и копируется в Dockerfile.
dev_sse/
*_test.py
**/*_test.py
README.md

# --- служебное ---
.git
.gitignore
.dockerignore
Dockerfile
