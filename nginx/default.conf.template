# Шаблон nginx-конфига (Фаза 10). Монтируется в /etc/nginx/templates/
# официального образа nginx: entrypoint прогоняет envsubst и кладёт
# результат в /etc/nginx/conf.d/default.conf. Подставляются ТОЛЬКО
# переменные окружения (${NETOPS_INTERNAL_SERVICE_TOKEN},
# ${NETOPS_PROXY_AUTH_SECRET}); nginx-переменные ($host, $http_upgrade,
# $connection_upgrade, $upstream_http_x_user_*) envsubst не трогает.

# WebSocket-Upgrade для socket.io Chainlit.
# map вне server: conf.d-файлы включаются внутри http {}, здесь это легально.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # --- SPA (старый фронтенд) ---
    location / {
        try_files $uri /index.html;
    }

    # --- FastAPI: REST/SSE ---
    # proxy_buffering off обязателен: SSE-стриминг чата (data: {json}).
    location /api/ {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
    }

    # --- FastAPI: админка Jinja2/HTMX ---
    # /admin без слэша иначе уходит в SPA try_files, а не в админку.
    location = /admin {
        return 302 /admin/;
    }
    location /admin/ {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }

    # --- Внутренние маршруты: недостижимы снаружи (404) ---
    # auth_request ходит не через этот location, а в = /_auth ниже.
    location /internal/ {
        internal;
        proxy_pass http://app:8000;
    }

    # --- Подзапрос auth_request -> GET /internal/auth-check (Фаза 7) ---
    # Пустой NETOPS_INTERNAL_SERVICE_TOKEN = /internal/* выключены на
    # backend, auth-check ответит 401 -> все /chat получают редирект
    # на /admin/login через error_page ниже. (Для auth_request годятся
    # только 2xx/401/403; 404/500 превращаются в 500 у клиента.)
    location = /_auth {
        internal;
        proxy_pass http://app:8000/internal/auth-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Internal-Service-Token "${NETOPS_INTERNAL_SERVICE_TOKEN}";
    }

    # --- Chainlit-чат: только для авторизованных ---
    # Префикс /chat ловит всё приложение: /chat, /chat/assets, /chat/public,
    # /chat/login, /chat/logout, /chat/ws/socket.io (WebSocket).
    # CHAINLIT_ROOT_PATH=/chat в сервисе chainlit задаёт те же префиксы.
    location /chat {
        auth_request /_auth;
        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_email $upstream_http_x_user_email;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_display_name $upstream_http_x_user_display_name;

        # Неавторизованный -> форма логина админки (403 "отключён"
        # остаётся честным 403).
        error_page 401 =302 /admin/login;

        proxy_pass http://chainlit:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # WebSocket (socket.io)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Proxy-авторизация Chainlit: пустой секрет = заголовок не
        # передаётся, header-auth выключен, работает логин-форма.
        proxy_set_header X-Proxy-Auth-Secret "${NETOPS_PROXY_AUTH_SECRET}";
        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Display-Name $auth_user_display_name;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
